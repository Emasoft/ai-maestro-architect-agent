# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
.eggs/
dist/
build/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Linting
.ruff_cache/

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Dev folders (NEVER PUBLISH - development artifacts only)
# Wildcard pattern catches all: docs_dev, scripts_dev, tests_dev, samples_dev,
# examples_dev, downloads_dev, libs_dev, builds_dev, reports_dev, etc.
*_dev/

# Agent / skill / tool reports (private — paths, internal notes, may include
# secrets that leaked into logs). See ~/.claude/rules/agent-reports-location.md
# /reports_dev/ is already matched by *_dev/ above; the explicit entry exists
# so scanners that look for the literal path find it.
/reports/
/reports_dev/

# Environment & secrets
.env
.env.*

# Virtual environments
.venv/
venv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Logs
*.log

# Node
node_modules/

# Rust
target/
Cargo.lock

# Claude Code
.claude/**

# The PROJECT memory scope lives in-repo under .claude/ and MUST be tracked +
# pushed (the shared, cross-dev wiki memory). Re-include it via these exceptions.
!.claude/project/
!.claude/project/memory/
!.claude/project/memory/**
# ...but NOT the regeneratable memgrep sqlite index (cache, not knowledge).
.claude/project/memory/.memgrep/

# Janitor per-project state/logs (regeneratable — see ~/.claude/rules/janitor-footprint.md)
/.janitor/

# LLM Externalizer
llm_externalizer_output/

# TLDR cache
.tldr/
.tldrignore
.tldr_session_*

# SERENA MCP state (local project metadata, not published)
.serena/

# git-cliff scratch — ephemeral release notes between bump and push
.git-cliff-release-notes.md
